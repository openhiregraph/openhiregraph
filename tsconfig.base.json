{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@openhiregraph/types": ["libs/types/src/index.ts"]
    },
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "tmp"]
}
